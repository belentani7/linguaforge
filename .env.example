# Variables de entorno documentadas.
# Nunca escribir secretos reales aqui.
# Copia a .env.local (ignorado por Git) y ajusta.
# Ningún proveedor externo está activo por defecto.
# APP_ENV=development

# Obligatorio en producción (mínimo 32 caracteres). Firma la cookie de sesión local.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Puerto de la API Express (por defecto 3001). Vite reenvía /api a este puerto en desarrollo.
PORT=3001

# Fichero JSON del repositorio de desarrollo (por defecto data/learning-store.json).
# LF_DATA_FILE=data/learning-store.json

# Base de datos de DESARROLLO (opcional). Activa MySQL/MariaDB con LF_STORE=mysql.
# Sólo instancias locales (127.0.0.1) y bases linguaforge_dev / linguaforge_test. Nunca producción.
# LF_STORE=memory
# DATABASE_URL=mysql://lf_dev:CAMBIAR@127.0.0.1:3306/linguaforge_dev
# TEST_DATABASE_URL=mysql://lf_dev:CAMBIAR@127.0.0.1:3306/linguaforge_test
